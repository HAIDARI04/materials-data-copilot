# Copy this file to .env on each PC and edit the path for that machine.
# Keep the active SQLite catalog local; Google Drive holds file payloads and
# timestamped, verified backups.
MDC_LOCAL_DATA_DIR=backend/data
MDC_SHARED_DATA_DIR=G:/My Drive/MDC-Data

# Optional override. Do not point this at a synchronized cloud folder.
# MDC_DATABASE_PATH=backend/data/materials_data_copilot.db
